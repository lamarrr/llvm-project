BasedOnStyle: LLVM
LineEnding: LF
CommentPragmas: '^ (IWYU pragma:|RUN:|[A-Z][A-Z0-9_-]*:|[A-Za-z][A-Za-z0-9_-]*-(error|warning|note|remark|no-diagnostics))'
StatementMacros:
  - __compute
  - __vertex
  - __fragment
  - __tessellation_control
  - __tessellation_evaluation
  - __task
  - __mesh
  - __ray_generation
  - __intersection
  - __any_hit
  - __closest_hit
  - __miss
  - __callable
  - __geometry
  - __geometry_mode
  - __geometry_invocations
  - __output_vertices
  - __tessellation_mode
  - __mesh_output
  - __early_fragment_tests
  - __post_depth_coverage
  - __fragment_interlock
  - __noncoherent_color_attachment_read
  - __noncoherent_depth_attachment_read
  - __noncoherent_stencil_attachment_read
  - __depth_greater
  - __depth_less
  - __depth_unchanged
  - __workgroup_size
  - __workgroup_size_id
AttributeMacros:
  - __primitive_id
  - __invocation_id
  - __layer
  - __viewport_index
  - __tess_level_outer
  - __tess_level_inner
  - __tess_coord
  - __patch_vertices
  - __primitive_point_indices
  - __primitive_line_indices
  - __primitive_triangle_indices
  - __cull_primitive
  - __patch
  - __per_primitive
  - __task_payload
  - __ray_payload
  - __incoming_ray_payload
  - __hit_attribute
  - __callable_data
  - __incoming_callable_data
  - __shader_record
  - __binding
  - __storage
  - __uniform
  - __push_constant
  - __shared
  - __input
  - __output
  - __location
  - __position
  - __frag_depth
  - __stencil_ref
  - __sample_mask
  - __point_size
  - __clip_distance
  - __cull_distance
  - __flat
  - __varying
  - __noperspective
  - __centroid
  - __sample
BinPackParameters: true
AlignAfterOpenBracket: Align
