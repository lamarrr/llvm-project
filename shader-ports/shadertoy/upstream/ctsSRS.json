  "image_code": "void mainImage(out vec4 c,in vec2 o){\n  c=vec4(1);\n  float y=floor(o.y/12.0);\n  float x=floor(o.x/12.0);\n  float square=x*x+y*y+iTime/7.0;\n  c*=ceil((vec4(ceil(sin(square))+mod(y,2.0))+vec4(floor(cos(square))+mod(x,2.0))));\n  if (length(c)<=0.0)c=vec4(0);;\n  c=1.0-c;\n}",
